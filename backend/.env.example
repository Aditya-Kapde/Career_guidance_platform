# ============================================================
# PathFinder AI — Production Environment Variables Reference
# ============================================================

# Network & Server Port
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS & PDF Service
CLIENT_URL=https://pathfinder-career-guidance.vercel.app

# Persistent MongoDB Database Cluster Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pathfinder_production?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/pathfinder_production
MONGODB_URI=mongodb+srv://production_user:your_secure_db_password@cluster0.xxxxx.mongodb.net/pathfinder_production?retryWrites=true&w=majority

# JWT Session Authentication Secret (High-entropy 256-bit key)
JWT_SECRET=your_super_secret_production_jwt_signing_key_at_least_64_chars_long

# Groq LLM API Key & Model for AI Narrative Consulting
GROQ_API_KEY=gsk_your_groq_production_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional Puppeteer Executable Path for Cloud Containers (e.g. /usr/bin/google-chrome-stable)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser